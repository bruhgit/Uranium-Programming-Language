fn kmToMiles(km) {
return km * 0.621371
}

fn milesToKm(miles) {
return miles * 1.609344
}

fn metersToFeet(meters) {
return meters * 3.28084
}

fn feetToMeters(feet) {
return feet / 3.28084
}

fn celsiusToFahrenheit(celsius) {
return ((celsius * 9) / 5) + 32
}

fn fahrenheitToCelsius(fahrenheit) {
return ((fahrenheit - 32) * 5) / 9
}

fn kgToPounds(kg) {
return kg * 2.20462
}

fn poundsToKg(pounds) {
return pounds / 2.20462
}

fn litersToGallons(liters) {
return liters * 0.264172
}

fn gallonsToLiters(gallons) {
return gallons / 0.264172
}

fn degreesToRadians(degreesValue) {
return radians(degreesValue)
}

fn radiansToDegrees(radiansValue) {
return degrees(radiansValue)
}

fn cmToInches(cm) {
return cm / 2.54
}

fn inchesToCm(inches) {
return inches * 2.54
}
