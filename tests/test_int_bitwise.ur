fn main() {
    let a: int = 5
    let b: int = 2
    
    print("Integer Addition: ")
    print(a + b) // 7
    print("\n")
    
    print("Integer Subtraction: ")
    print(a - b) // 3
    print("\n")
    
    print("Integer Modulo: ")
    print(a % b) // 1
    print("\n")
    
    print("Bitwise AND (5 & 3): ")
    print(5 & 3) // 1
    print("\n")
    
    print("Bitwise OR (5 | 3): ")
    print(5 | 3) // 7
    print("\n")
    
    print("Bitwise XOR (5 ^ 3): ")
    print(5 ^ 3) // 6
    print("\n")
    
    print("Bitwise NOT (~5): ")
    print(~5) // -6
    print("\n")
    
    print("Shift Left (1 << 3): ")
    print(1 << 3) // 8
    print("\n")
    
    print("Shift Right (8 >> 2): ")
    print(8 >> 2) // 2
    print("\n")
    
    return 0
}

main()
